# Copia este archivo como .env y completa los valores reales.
# PORT es el puerto gRPC (main.ts lo usa como url: 0.0.0.0:${PORT}).
# api-gateway debería apuntar a este puerto vía FINANCE_GRPC_URL cuando se
# conecte (fuera de alcance del scaffolding inicial).
PORT=50054
NATS_SERVERS="nats://localhost:4222"

# Usa una base de datos propia, NO auth_db ni rehab_db: el datasource de este
# servicio (prisma/schema.prisma) no tiene habilitado el feature "multiSchema"
# de Prisma, así que un query param `?schema=xxx` se ignora por completo y las
# tablas terminarían creándose en el schema "public" de otra base, mezcladas
# con las de otro servicio. Crea la base a mano (el docker-compose.yml de
# backend/ solo levanta un Postgres compartido, no crea bases por servicio):
# docker exec -it postgres psql -U lifetrack -c 'CREATE DATABASE finance_db;'
DATABASE_URL="postgresql://lifetrack:devpass123@localhost:5432/finance_db"
