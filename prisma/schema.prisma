// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  CARD
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionKind {
  INCOME
  EXPENSE
}

enum RecurringMode {
  AUTO
  REMIND
}

enum DebtType {
  CREDIT_CARD
  LOAN
  OTHER
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  ARCHIVED
}

model Account {
  id        String      @id @default(uuid())
  userId    String
  name      String
  type      AccountType @default(OTHER)
  currency  String
  balance   Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions   Transaction[]
  recurringItems RecurringItem[]
  debts          Debt[]

  @@index([userId])
}

model Category {
  id        String       @id @default(uuid())
  userId    String
  name      String
  kind      CategoryKind
  icon      String?
  color     String?
  createdAt DateTime     @default(now())

  transactions   Transaction[]
  budgets        Budget[]
  recurringItems RecurringItem[]
  debts          Debt[]

  @@index([userId])
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  accountId       String
  account         Account         @relation(fields: [accountId], references: [id])
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  amount          Float
  kind            TransactionKind
  description     String?
  occurredAt      DateTime
  recurringItemId String?
  recurringItem   RecurringItem?  @relation(fields: [recurringItemId], references: [id])
  debtId          String?
  debt            Debt?           @relation(fields: [debtId], references: [id])
  interestAmount  Float?
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@index([accountId])
  @@index([categoryId, occurredAt])
  @@index([recurringItemId, occurredAt])
  @@index([debtId, occurredAt])
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  amount      Float
  periodMonth Int
  periodYear  Int
  createdAt   DateTime @default(now())

  @@unique([categoryId, periodMonth, periodYear])
  @@index([userId])
}

model RecurringItem {
  id                 String          @id @default(uuid())
  userId             String
  name               String
  amount             Float
  kind               TransactionKind
  accountId          String
  account            Account         @relation(fields: [accountId], references: [id])
  categoryId         String
  category           Category        @relation(fields: [categoryId], references: [id])
  dayOfMonth         Int
  mode               RecurringMode
  active             Boolean         @default(true)
  lastGeneratedMonth Int?
  lastGeneratedYear  Int?
  createdAt          DateTime        @default(now())

  transactions Transaction[]

  @@index([userId])
  @@index([userId, active])
}

model Debt {
  id                  String     @id @default(uuid())
  userId              String
  name                String
  lender              String?
  type                DebtType   @default(OTHER)
  currency            String
  totalOwed           Float
  originalAmount      Float?
  minimumPayment      Float?
  dueDay              Int?
  installmentCount    Int?
  startingInstallment Int        @default(0)
  accountId           String?
  account             Account?   @relation(fields: [accountId], references: [id])
  categoryId          String
  category            Category   @relation(fields: [categoryId], references: [id])
  status              DebtStatus @default(ACTIVE)
  lastPaymentMonth    Int?
  lastPaymentYear     Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@index([userId, status])
}
